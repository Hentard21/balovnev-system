{
  // Cloudflare Pages Functions выполняются в Workers-рантайме, а не в Node
  // и не в браузере — поэтому у них отдельный tsconfig с типами воркеров.
  // Из сборки сайта эта папка исключена (см. корневой tsconfig.json).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
