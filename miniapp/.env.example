# SQLite-файл на диске сервера (требование локализации ПДн — держите его на VPS в РФ).
#
# Путь ОБЯЗАТЕЛЬНО начинается с ../ — Prisma резолвит относительный путь не от
# корня проекта, а от папки со schema.prisma (то есть от prisma/). С «./data/»
# база уедет в prisma/data/ мимо тома ./data:/app/data из docker-compose и будет
# стираться при каждой пересборке контейнера.
DATABASE_URL="file:../data/miniapp.db"

# Токен бота от @BotFather — нужен для проверки подписи Telegram initData.
# Вставьте, когда бот будет создан.
TELEGRAM_BOT_TOKEN=""

# Telegram ID тренера (Игоря) — числовой user id из Telegram.
# Узнать свой id можно у бота @userinfobot.
TRAINER_TELEGRAM_ID=""

# Секрет для подписи сессионной cookie (любая длинная случайная строка).
SESSION_SECRET="change-me-to-a-long-random-string"

# Разрешить вход без реального Telegram (мок-пользователь) — только для
# локальной разработки, пока нет бота. НИКОГДА не включайте в проде.
DEV_AUTH_BYPASS="true"
